    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "@types/pg": "^8.23.1",
    "androidtv-remote": "^1.0.10",
    "bonjour-service": "^1.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "ws": "^8.18.0"
  },
  "devDependencies": {
