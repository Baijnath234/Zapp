# Zapp Backend Configuration
PORT=3000
NODE_ENV=development

# Cloud Database URL (takes priority if provided on Railway, Render, Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://zapp_user:zapp_secret@localhost:5433/zapp_db?sslmode=disable
# DATABASE_SSL=false

# Local PostgreSQL Database (Docker)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=zapp_user
DATABASE_PASSWORD=zapp_secret
DATABASE_NAME=zapp_db
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false
